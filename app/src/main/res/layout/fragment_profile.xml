<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/ivCoverBanner"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#1A1208"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btnAdminLair"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_profile_circle"
                    android:backgroundTint="#0D0D0D"
                    android:src="@android:drawable/ic_menu_manage"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#F0C060" />

                <FrameLayout
                    android:id="@+id/profileImageContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="90dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_circle"
                        android:scaleType="centerCrop"
                        tools:src="@android:drawable/ic_dialog_info" />

                    <ImageButton
                        android:id="@+id/btnUploadImage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_profile_circle"
                        android:backgroundTint="#D97706"
                        android:contentDescription="Upload Image"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#0D0D0D" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layoutActionButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivCoverBanner">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Edit Profile"
                        android:textColor="#F0C060"
                        app:cornerRadius="20dp"
                        app:strokeColor="#D97706" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log Out"
                        android:textColor="#B8620E"
                        app:cornerRadius="20dp"
                        app:strokeColor="#4A2E08" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:textColor="#F0C060"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/profileImageContainer"
                    tools:text="Anas Faiz" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutCampusCred"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_profile_circle"
                    android:backgroundTint="#1A1208"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvProfileName"
                    app:layout_constraintStart_toEndOf="@id/tvProfileName"
                    app:layout_constraintTop_toTopOf="@id/tvProfileName">

                    <View
                        android:id="@+id/viewCredEruption"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_profile_circle"
                        android:backgroundTint="#D97706"
                        app:layout_constraintBottom_toBottomOf="@id/ivCredFlame"
                        app:layout_constraintEnd_toEndOf="@id/ivCredFlame"
                        app:layout_constraintStart_toStartOf="@id/ivCredFlame"
                        app:layout_constraintTop_toTopOf="@id/ivCredFlame" />

                    <ImageView
                        android:id="@+id/ivCredFlame"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_flame_cred"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvCampusCred"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#F0C060"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivCredFlame"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="1.2k" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFlairs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileName">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0C060"
                        app:chipBackgroundColor="#1A1208"
                        app:chipStrokeColor="#4A2E08"
                        app:chipStrokeWidth="1dp"
                        tools:text="BS Computer Science" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0C060"
                        app:chipBackgroundColor="#1A1208"
                        app:chipStrokeColor="#4A2E08"
                        app:chipStrokeWidth="1dp"
                        tools:text="Class of '26" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:textColor="#D4882A"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/chipGroupFlairs"
                    tools:text="Building the future of campus connectivity. Code, coffee, and late-night library runs." />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/profileTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1208"
            app:tabIndicatorColor="#D97706"
            app:tabSelectedTextColor="#F0C060"
            app:tabTextColor="#D4882A" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/profileViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>